<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-launchd.sh fills in __SYLLARA_BIN__ and __HOME__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.syllara.check</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SYLLARA_BIN__</string>
        <string>check</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.syllara/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.syllara/logs/launchd.err.log</string>
</dict>
</plist>
